{
  "version": 2,
  "builds": [
    { "src": "api/indices.js", "use": "@vercel/node" },
    { "src": "api/option-chain/index.js", "use": "@vercel/node" },
    { "src": "api/stock/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/indices", "dest": "/api/indices.js" },
    { "src": "/api/option-chain/(.*)", "dest": "/api/option-chain/index.js" },
    { "src": "/api/stock/(.*)", "dest": "/api/stock/index.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}